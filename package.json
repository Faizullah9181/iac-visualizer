{
  "name": "iac-visualizer",
  "private": true,
  "version": "0.1.0",
  "description": "Kachua turns Terraform, CloudFormation, Ansible and OpenTelemetry Collector config into a live, explorable architecture diagram with dependency tracing, linting and blast-radius analysis.",
  "keywords": [
    "infrastructure-as-code",
    "iac",
    "terraform",
    "cloudformation",
    "ansible",
    "opentelemetry",
    "otel-collector",
    "aws",
    "architecture-diagram",
    "visualization",
    "devops",
    "linter"
  ],
  "author": "Faizullah <faizullah9181@gmail.com>",
  "homepage": "https://github.com/Faizullah9181/iac-visualizer#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Faizullah9181/iac-visualizer.git"
  },
  "bugs": {
    "url": "https://github.com/Faizullah9181/iac-visualizer/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@dagrejs/dagre": "^1.1.8",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "@uiw/react-codemirror": "^4.25.12",
    "@xyflow/react": "^12.12.0",
    "aws-icons": "3.3.0",
    "framer-motion": "^11.18.2",
    "html-to-image": "1.11.11",
    "lucide-react": "^1.61.0",
    "lz-string": "^1.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "yaml": "^2.9.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  }
}
